{
    "window.titleBarStyle": "custom",
    "window.commandCenter": true,
    "workbench.colorCustomizations": {
        "activityBar.background": "#0E7C66",
        "activityBar.foreground": "#F6FFFC",
        "activityBar.activeBackground": "#139178",
        "activityBar.inactiveForeground": "#F6FFFC99",
        "activityBarBadge.background": "#FFD166",
        "activityBarBadge.foreground": "#1D1D1D",
        "statusBar.background": "#0B6A57",
        "statusBar.foreground": "#F6FFFC",
        "statusBar.debuggingBackground": "#F59E0B",
        "statusBar.debuggingForeground": "#1D1D1D",
        "statusBarItem.hoverBackground": "#095847",
        "titleBar.activeBackground": "#0B6A57",
        "titleBar.activeForeground": "#F6FFFC",
        "titleBar.inactiveBackground": "#0B6A5799",
        "titleBar.inactiveForeground": "#F6FFFC99",
        "tab.activeBorderTop": "#FFD166",
        "sash.hoverBorder": "#0E7C66",
        "editorGroup.border": "#0E7C66",
        "panel.border": "#0E7C66",
        "sideBar.border": "#0E7C66"
    },

    // GitHub Copilot configuration
    "github.copilot.enable": {
        "*": true,
        "yaml": true,
        "plaintext": true,
        "markdown": true,
        "python": true
    },
    "github.copilot.chat.instructionsFile": ".github/copilot-instructions.md"
}